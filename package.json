{
  "name": "agent-office",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "dev": "npm run dev --workspaces --if-present",
    "start": "sh -c 'npm run start --workspace=@agent-office/server & SERVER_PID=$!; npm run dev --workspace=@agent-office/ui; kill $SERVER_PID'",
    "estate": "sh -c 'npm run start --workspace=@agent-office/estate-server & SERVER_PID=$!; trap \"kill $SERVER_PID\" EXIT; npm run dev --workspace=@agent-office/estate'",
    "estate:server": "npm run start --workspace=@agent-office/estate-server",
    "estate:client": "npm run dev --workspace=@agent-office/estate"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "playwright": "1.64.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.2"
  }
}
