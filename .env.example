# Tavily API key (optional) — enables Tavily web search for agents.
# When set, web_search calls use Tavily; otherwise DuckDuckGo is used as fallback.
# Get your key at https://app.tavily.com
TAVILY_API_KEY=

# You.com API key (optional) — enables You.com web search for agents.
# When set, web_search uses You.com search instead of Tavily/DuckDuckGo.
# The keyless free profile at https://api.you.com/mcp?profile=free also works
# without an API key — just set YDC_API_KEY to any non-empty value.
# Get an API key at https://you.com/platform/api-keys
YDC_API_KEY=