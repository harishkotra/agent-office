# ═══════════════════════════════════════════════════════════════════
# Ciudadan AgentOffice — environment configuration
# Copy to `.env` and adjust as needed. Variables already defined in the
# shell ALWAYS win over this file (nothing is overridden).
# ═══════════════════════════════════════════════════════════════════

# ─── Orchestration mode ────────────────────────────────────────────
# external (DEFAULT): the office is a visual shell driven by the
#   external interface (/api/external). NO LLM inference, NO tool
#   execution, NO autonomous hiring/tasks/conversations. This is the
#   mode for the DSH/Cline integration (Block 2).
# internal: original upstream behavior (Ollama think loop, tools,
#   autonomous agents). Requires Ollama at OLLAMA_URL.
AGENT_OFFICE_MODE="external"

# ─── Server (Colyseus + REST) ──────────────────────────────────────
# Network interface. 127.0.0.1 keeps everything local-only (recommended).
HOST="127.0.0.1"
# Colyseus WebSocket + REST API port.
PORT="3000"

# ─── UI (Vite dev server) ──────────────────────────────────────────
UI_HOST="127.0.0.1"
UI_PORT="5173"

# ─── Internal mode only (ignored in external mode) ─────────────────
# Ollama endpoint used by the original orchestrator + embeddings.
OLLAMA_URL="http://127.0.0.1:11434"
# Tavily API key (optional) — enables Tavily web search for agents in
# internal mode. Without it, DuckDuckGo is used as fallback.
# Get your key at https://app.tavily.com
TAVILY_API_KEY=""

# ─── External interface ────────────────────────────────────────────
# Accept external updates through /api/external (external mode only).
EXTERNAL_API_ENABLED="true"
# ⚠️ DEMO / TEST DATA: registers 7 fake agents named "[DEMO] ..." that
# simulate activity so the UI can be verified without a real
# orchestrator. DISABLED by default. Never use in production.
EXTERNAL_DEMO_MODE="false"
# Optional shared secret; when set, every /api/external call must send it
# in the X-AgentOffice-Token header (or Authorization: Bearer ...).
# Leave empty to rely on the localhost-only binding.
EXTERNAL_API_TOKEN=""

# ─── Real agents integration (Block 2) ────────────────────────────
# Observe REAL Cline sessions (strictly read-only) and mirror them in
# the office: identity, states, tasks and activity. Never spawns or
# modifies Cline processes.
REAL_AGENTS_ENABLED="true"
# Cline data directory (must contain db/sessions.db and sessions/).
# This machine's sessions live in /workspace/.cline/data because the
# agent runs with --config /workspace/.cline.
CLINE_DATA_DIR="/workspace/.cline/data"
# Low-impact polling interval in ms (minimum 2000).
CLINE_POLL_INTERVAL_MS="5000"
# Block 3: grace (ms) that a completed/offline session keeps its desk
# visible before the seat is released (history is preserved in REST +
# events). Terminal sessions that ended LONG before startup get no
# grace. 0 = release immediately.
TERMINAL_GRACE_MS="60000"
# DSH integration source: 'none' (no DSH) or 'http' (REAL provider —
# Ciudadan Bloque 2: goals/create|pause|resume|complete|clear sobre el
# protocolo verificado del servidor web de DSH).
DSH_SOURCE="none"
# DSH web origin. The DSH v1 web server has NO auth layer and trusts only
# loopback/trustedHosts: use same-machine or an SSH tunnel
# (e.g. ssh -L 13080:127.0.0.1:3080 ... → DSH_URL=http://127.0.0.1:13080).
DSH_URL=""
# Reserved for the future DSH auth layer (sent as X-DSH-Token when set).
DSH_TOKEN=""
# DSH SessionId that OWNS (and executes) the goals created by the provider.
# The Host cold-resumes that session when necessary (dsh-api-remotes policy).
# ⚠️ NOTE the AGENTOFFICE_ prefix: the harness injects its own DSH_SESSION_ID
# into every process it launches (verified 2026-10-26) and the .env loader
# never overrides variables already present in the environment.
AGENTOFFICE_DSH_SESSION_ID=""
# DSH harness credential store (dsh-credentials-local, YAML). The provider
# mints the SAME signed browser cookie the web UI holds (record
# client-connection/browser-session) because `dsh web` requires it on
# every /api call. The secret never leaves the process (never logged).
# Default: <DSH_HOME>/.credentials.yaml (or ~/.dsh/.credentials.yaml).
AGENTOFFICE_DSH_CREDENTIALS=""
# Round cap applied to goals created through the provider (default 8).
DSH_MAX_GOAL_ROUNDS="8"

# ─── Block 4: interactive control center ───────────────────────────
# MANDATORY server-side credential for ANY control write action
# (instructions, tasks, sprints). When empty, writes answer 503 —
# they never open silently. Generate e.g. with: openssl rand -hex 16
AGENTOFFICE_CONTROL_TOKEN=""
# Master switch for instruction dispatch to real Cline sessions.
# Disabled by default: dispatch additionally requires a VALIDATED
# adapter (hub with dispatchable sessions). With it disabled,
# approved instructions stay honestly "pending" with the cause.
INSTRUCTION_DISPATCH_ENABLED="false"
# Absolute path of the Cline SDK (@cline/core ESM bundle).
CLINE_SDK_PATH="/usr/lib/node_modules/cline/node_modules/@cline/core/dist/index.js"
# Hub discovery record (url + authToken) — read in-memory only.
CLINE_HUB_RECORD_PATH="~/.cline/data/locks/hub/production.json"
# Global instruction rate limit (requests per minute).
INSTRUCTION_RATE_PER_MINUTE="10"

# ─── Block 5: security ─────────────────────────────────────────────
# Optional token; when set, Colyseus WebSocket joins must present it
# (UI: ?wstoken=… query param, kept in sessionStorage). Required for
# remote access through a private proxy; empty = localhost mode.
OFFICE_WS_TOKEN=""
# When HOST is NOT loopback: the only Origin allowed to call the REST
# API (e.g. https://esfericulos.cuidadan.org). Empty = same-origin.
ALLOWED_ORIGIN=""

# ─── Block 5: hub-managed sessions (control real) ──────────────────
# Provider/model used for office-launched hub sessions. It MUST match
# what the OPERATOR configured in the HUB's own config dir (~/.cline of
# the hub daemon) via the official procedure — the app never copies keys:
#   cline --config ~/.cline auth -p nvidia -k <CLAVE> -m z-ai/glm-5.3
#   (or interactively: cline --config ~/.cline auth → 'cline' + cline-free/*)
# E2E-verified options: nvidia/z-ai/glm-5.3, cline/cline-free/mimo-v2.6-flash.
HUB_PROVIDER_ID="nvidia"
HUB_MODEL_ID="z-ai/glm-5.3"
# Restrictive tool permissions for managed sessions (false = the agent
# cannot run commands/write files; enable ONLY with a sandboxed env).
HUB_SESSION_TOOLS="false"
# Isolated workspace root (one directory per launched session).
HUB_SESSION_WORKSPACES="./data/hub-workspaces"

# ─── NVIDIA inference test (Block 2, OPTIONAL) ─────────────────────
# Used ONLY by `npm run test:nvidia` — a single-message compatibility
# check. Never used by the office; never enables autonomous agents.
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# Subject to availability in the account (the script reports a clear
# error if the model is not available).
# NOTE (2026-10-10): deepseek-v4-flash-0731 returns 410 Gone on this
# account. Available variants observed in the catalog: deepseek-v4.1-flash
# (timed out) and z-ai/glm-5.3 (tested OK: 21+59 tokens, 2.9s).
NVIDIA_MODEL="deepseek-ai/deepseek-v4-flash-0731"
# The credential lives in the environment — NEVER hardcode it here.
# If unset, the script falls back to the nvidia provider key configured
# in the authorized Cline settings (CLINE_DATA_DIR/settings/providers.json).
NVIDIA_API_KEY=""

# ─── Storage ───────────────────────────────────────────────────────
# SQLite database (tasks, layouts, memories). Created automatically.
DATABASE_PATH="./data/office-memory.db"

# ─── Capacity ──────────────────────────────────────────────────────
# Maximum agent seats. Hard-capped at 7 — the office never expands.
MAX_SEATS="7"

