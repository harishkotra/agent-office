# Tavily API key (optional) — enables Tavily web search for agents.
# When set, web_search calls use Tavily; otherwise DuckDuckGo is used as fallback.
# Get your key at https://app.tavily.com
TAVILY_API_KEY=

# Optional explicit provider: parallel, duckduckgo, tavily, or none (disables search).
# Leave empty to keep automatic selection: Tavily when its key is set, DuckDuckGo otherwise.
# Parallel uses free anonymous Search MCP, with no account or API key.
WEB_SEARCH_PROVIDER=
